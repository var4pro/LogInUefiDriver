[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = LogInDriver
  FILE_GUID                      = 1A6FF461-0C3A-4351-B4BD-E596B27C6F7C
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = DriverEntryPoint

[Sources]
  #maintest.c
  src/Main.c
  src/Allocator.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  SecurityPkg/SecurityPkg.dec
  CryptoPkg/CryptoPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  BaseCryptLib
  #Tpm2CommandLib
  #Tpm2DeviceLib

[Protocols]
  #gEfiTcg2ProtocolGuid

[BuildOptions]
GCC:*_*_X64_CC_FLAGS = -std=c23 -I$(MODULE_DIR)/include/
GCC:*_*_X64_CC_FLAGS = -fstrict-flex-arrays=3
GCC:*_*_X64_CC_FLAGS = -std=c23 -I$(MODULE_DIR)/include/ -ftrivial-auto-var-init=zero -fzero-init-padding-bits=all
GCC:*_*_X64_CC_FLAGS = -funsigned-char -fno-delete-null-pointer-checks -fno-finite-loops -fno-strict-aliasing

#warnings
GCC:*_*_X64_CC_FLAGS = -Wall -Wextra -Wpedantic -Wshadow -Wno-unused-parameter -Wpointer-arith -Wframe-larger-than=4096 -Wformat=2 -Wnull-dereference -Wswitch-enum -Wswitch-default -Wtrivial-auto-var-init -Wuseless-cast -Wstrict-flex-arrays -Wattribute-alias=2 -Wduplicated-branches -Wduplicated-cond -Wtrampolines -Wundef -Wcast-qual -Wwrite-strings -Wconversion -Wsign-conversion -Wflex-array-member-not-at-end -Wlogical-op -Wdeprecated-non-prototype -Wmissing-prototypes -Wmissing-variable-declarations -Wmissing-declarations -Wnested-externs -Winvalid-pch -Wvla-larger-than=1024
GCC:*_*_X64_CC_FLAGS = -Wno-error

#TODO: integrate analyzer into cicd pipeline
GCC:NOOPT_*_X64_CC_FLAGS = -O0 -flto -fanalyzer